# Environment variables override config/config.yml and are overridden by
# command line arguments. Each name is the uppercased dotted path of the key it
# overrides, with `.` replaced by `_`. See the Configuration section of the README.

ENV=development
SERVE_PORT=8080

# Database
DATABASE_URL="postgres://postgres:password@db:5432/example"
DATABASE_POOL_MAX_SIZE=50
DATABASE_TIMEOUT=5
DATABASE_RUN_MIGRATIONS=true
DATABASE_RUN_SEEDS=false

# REST_API docs
SWAGGER_ENDPOINT=/docs
# username:password
SWAGGER_BASIC_AUTH=

# GraphQL docs
GRAPHQL_ENDPOINT=/graphql
# username:password
GRAPHQL_BASIC_AUTH=

# Auth
JWT_SECRET=change-me-to-a-secure-random-string-at-least-256-bits
JWT_EXPIRATION_DAYS=7
JWT_REFRESH_EXPIRATION_DAYS=30

# Password hashing
BCRYPT_COST=12

# Workers
WORKERS_TOKEN_RETENTION_DAYS=7
WORKERS_INTERVAL_HOURS=24

# Configures which modules `tracing_subscriber` should emit logs for.
#
# This variable is read by `tracing_subscriber`, not the application itself, so it won't appear on the `Settings` struct.
#
# The value here enables log messages from the backend application as well as log messages emitted for incoming requests.
RUST_LOG=server=debug,tower_http=info,sqlx=info
